_tikz/

# Generated TikZ SVG assets — rebuilt at jekyll build time from _plugins/tikz.rb
# Commit these if you want the site to be deployable without a TeX installation.
# Leave them gitignored if you prefer a clean repo and always build with Nix.
assets/tikz/

